{
    "waitUntil": "domcontentloaded",
    "save": [
        "markdown"
    ],
    "saveDestination": [
        "dataset"
    ],
    "maxRequestRetries": 3,
    "navigationTimeoutSecs": 60,
    "maxRequestsPerCrawl": 5,
    "selector": "a[href]",
    "exclude": [
        {
            "glob": "**/api/**"
        },
        {
            "glob": "**/blog/**"
        }
    ]
}
